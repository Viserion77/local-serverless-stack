{
  "name": "local-serverless-stack",
  "version": "0.11.0",
  "description": "Local control plane for serverless development with LocalStack orchestration",
  "author": "LSS Contributors",
  "license": "MIT",
  "bin": {
    "lss": "./bin/cli.js"
  },
  "main": "dist/client/index.js",
  "types": "dist/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "require": "./dist/client/index.js",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./bin/cli.js": "./bin/cli.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "serverless",
    "localstack",
    "lambda",
    "development",
    "orchestrator",
    "aws",
    "local"
  ],
  "files": [
    "bin/",
    "dist/",
    "packages/serverless-plugin/dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "packages/*",
    "src/ui"
  ],
  "scripts": {
    "build": "npm run ui:build && npm run server:build && npm run client:build && npm run plugin:build",
    "server:dev": "tsx watch src/server/index.ts",
    "server:build": "tsc --project src/server/tsconfig.json",
    "client:build": "tsc --project src/client/tsconfig.json",
    "ui:dev": "cd src/ui && npm run dev",
    "ui:build": "cd src/ui && npm run build",
    "plugin:build": "npm run build -w packages/serverless-plugin",
    "dev": "concurrently \"npm run server:dev\" \"npm run ui:dev\"",
    "setup": "npm install && cd src/ui && npm install",
    "prepublishOnly": "npm run build",
    "test": "jest -c jest.config.js",
    "test:unit": "jest -c jest.config.js",
    "test:watch": "jest -c jest.config.js --watch",
    "test:coverage": "jest -c jest.config.js --coverage",
    "test:integration": "jest -c jest.integration.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.709.0",
    "@aws-sdk/client-eventbridge": "^3.709.0",
    "@aws-sdk/client-lambda": "^3.709.0",
    "@aws-sdk/client-opensearchserverless": "^3.1085.0",
    "@aws-sdk/client-s3": "^3.1051.0",
    "@aws-sdk/client-sns": "^3.709.0",
    "@aws-sdk/client-sqs": "^3.709.0",
    "@aws-sdk/lib-dynamodb": "^3.709.0",
    "@aws-sdk/util-dynamodb": "3.974.0",
    "adm-zip": "^0.5.16",
    "awpaki": "^1.4.1",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/adm-zip": "^0.5.7",
    "@types/aws-lambda": "^8.10.160",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.30",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.53.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/viserion77/local-serverless-stack.git"
  },
  "bugs": {
    "url": "https://github.com/viserion77/local-serverless-stack/issues"
  },
  "homepage": "https://github.com/viserion77/local-serverless-stack#readme"
}
