{
  // LSS task palette — Terminal > Run Task (Ctrl+Shift+P > "Tasks: Run Task").
  // Icons are VS Code codicons (no emoji); colors use the terminal.ansi* theme keys.
  "version": "2.0.0",
  "tasks": [
    // ------------------------------------------------------------------
    // Build & dev
    // ------------------------------------------------------------------
    {
      "label": "build: all",
      "detail": "UI + server + client + MCP (npm run build)",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "icon": { "id": "package", "color": "terminal.ansiBlue" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build: server",
      "detail": "tsc for the orchestrator + engine (npm run server:build)",
      "type": "npm",
      "script": "server:build",
      "group": "build",
      "icon": { "id": "server-process", "color": "terminal.ansiBlue" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "dev: orchestrator + UI (watch)",
      "detail": "tsx watch on the server + vite dev on the UI (npm run dev)",
      "type": "npm",
      "script": "dev",
      "icon": { "id": "play-circle", "color": "terminal.ansiCyan" },
      "problemMatcher": []
    },
    {
      "label": "dev @ example self-hosted (watch, no build)",
      "detail": "npm run dev reading examples/self-hosted/lss.config.json — LSS on :14566 (dashboard, API and AWS wire), Vite UI on :3101",
      "type": "shell",
      "command": "LSS_CONFIG_PATH=examples/self-hosted/lss.config.json npm run dev",
      "isBackground": true,
      "icon": { "id": "play-circle", "color": "terminal.ansiCyan" },
      "problemMatcher": []
    },
    // ------------------------------------------------------------------
    // Tests & validation
    // ------------------------------------------------------------------
    {
      "label": "test: unit",
      "detail": "The full unit suite (npm test)",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "icon": { "id": "beaker", "color": "terminal.ansiGreen" },
      "problemMatcher": []
    },
    {
      "label": "test: watch",
      "detail": "The unit suite in watch mode",
      "type": "npm",
      "script": "test:watch",
      "icon": { "id": "sync", "color": "terminal.ansiCyan" },
      "problemMatcher": []
    },
    {
      "label": "test: coverage (gate 100%)",
      "detail": "The CI coverage gate (100% statements/branches/functions/lines)",
      "type": "npm",
      "script": "test:coverage",
      "group": "test",
      "icon": { "id": "shield", "color": "terminal.ansiYellow" },
      "problemMatcher": []
    },
    {
      "label": "test: integration (self engine, no Docker)",
      "detail": "End-to-end integration suite on the self engine — no Docker, no token",
      "type": "npm",
      "script": "test:integration",
      "group": "test",
      "icon": { "id": "plug", "color": "terminal.ansiMagenta" },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "detail": "eslint across the whole repository",
      "type": "npm",
      "script": "lint",
      "group": "test",
      "icon": { "id": "checklist", "color": "terminal.ansiMagenta" },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "lint: fix",
      "detail": "eslint --fix",
      "type": "npm",
      "script": "lint:fix",
      "icon": { "id": "wand", "color": "terminal.ansiMagenta" },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "typecheck: all projects",
      "detail": "tsc --noEmit on server/client/mcp/tests + vue-tsc on the UI",
      "type": "shell",
      // `tests/tsconfig.json` is in here because it was the only TypeScript in
      // the repo nobody checked: ts-jest transpiles file by file and never sees
      // a type error, and every src/ project excludes tests/. The result was
      // ~45 accumulated errors, invisible to CI and red in the editor — one of
      // them hiding a waitFor() whose wait returned immediately.
      //
      // The `client:build` in front of it is load-bearing, not decoration:
      // tests/integration/client.test.ts imports `../../dist/client` on purpose
      // (the consumer's view of the package), so typechecking the suite needs
      // that artifact. Without it the check passes on a dev box — which has a
      // dist/ — and fails on a clean checkout, which is exactly how it broke CI.
      "command": "npx tsc --noEmit -p src/server/tsconfig.json && npx tsc --noEmit -p src/client/tsconfig.json && npx tsc --noEmit -p src/mcp/tsconfig.json && npm run client:build && npx tsc --noEmit -p tests/tsconfig.json && cd src/ui && npx vue-tsc --noEmit",
      "group": "test",
      "icon": { "id": "verified", "color": "terminal.ansiBlue" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "validate: pre-prod",
      "detail": "The pre-publish gate: lint > typecheck > 100% coverage > full build",
      "dependsOrder": "sequence",
      "dependsOn": ["lint", "typecheck: all projects", "test: coverage (gate 100%)", "build: all"],
      "group": "test",
      "icon": { "id": "rocket", "color": "terminal.ansiGreen" },
      "problemMatcher": []
    },

    // ------------------------------------------------------------------
    // Example: self-hosted (LSS self engine, no Docker)
    // ------------------------------------------------------------------
    {
      "label": "example self-hosted: setup",
      "detail": "npm install in the example's 4 microservices",
      "type": "shell",
      "command": "npm run setup",
      "options": { "cwd": "${workspaceFolder}/examples/self-hosted" },
      "icon": { "id": "desktop-download", "color": "terminal.ansiBlue" },
      "problemMatcher": []
    },
    {
      "label": "example self-hosted: start (no Docker)",
      "detail": "Boots LSS on 14566 — dashboard, REST API and AWS wire on one listener",
      "type": "shell",
      "command": "npm run lss:start",
      "options": { "cwd": "${workspaceFolder}/examples/self-hosted" },
      "icon": { "id": "zap", "color": "terminal.ansiGreen" },
      "problemMatcher": []
    },
    {
      "label": "example self-hosted: register services",
      "detail": "sls package on the 4 services (registers and provisions them on the engine)",
      "type": "shell",
      "command": "npm run register:all",
      "options": { "cwd": "${workspaceFolder}/examples/self-hosted" },
      "icon": { "id": "cloud-upload", "color": "terminal.ansiBlue" },
      "problemMatcher": []
    },
    {
      "label": "example self-hosted: drive pipeline",
      "detail": "POST /orders, then follow the orders > billing > notifications flow",
      "type": "shell",
      "command": "curl -s -X POST http://localhost:3631/orders -H 'content-type: application/json' -d '{\"customerId\":\"u-ada\",\"total\":42.5}' && echo && sleep 2 && echo '--- ORDERS:' && curl -s http://localhost:3631/orders && echo && echo '--- RECEIPTS:' && curl -s http://localhost:3632/receipts && echo && echo '--- NOTIFICATIONS:' && curl -s http://localhost:3633/notifications && echo",
      "options": { "cwd": "${workspaceFolder}/examples/self-hosted" },
      "icon": { "id": "run-all", "color": "terminal.ansiCyan" },
      "problemMatcher": []
    },
    {
      "label": "example self-hosted: drive catalog (OpenSearch)",
      "detail": "Indexes products, then runs full-text search, filters and aggregations",
      "type": "shell",
      "command": "curl -s -X POST http://localhost:3634/products -H 'content-type: application/json' -d '{\"name\":\"Wireless Mouse\",\"category\":\"peripherals\",\"price\":25,\"tags\":[\"usb\",\"wireless\"]}' && echo && curl -s -X POST http://localhost:3634/products -H 'content-type: application/json' -d '{\"name\":\"Mechanical Keyboard\",\"category\":\"peripherals\",\"price\":90,\"tags\":[\"usb\"]}' && echo && curl -s -X POST http://localhost:3634/products -H 'content-type: application/json' -d '{\"name\":\"USB Hub\",\"category\":\"accessories\",\"price\":15,\"tags\":[\"usb\"]}' && echo && echo '--- SEARCH q=wireless:' && curl -s 'http://localhost:3634/search?q=wireless' && echo && echo '--- SEARCH category+maxPrice:' && curl -s 'http://localhost:3634/search?category=peripherals&maxPrice=50' && echo && echo '--- STATS:' && curl -s http://localhost:3634/stats && echo",
      "options": { "cwd": "${workspaceFolder}/examples/self-hosted" },
      "icon": { "id": "search", "color": "terminal.ansiCyan" },
      "problemMatcher": []
    },
    {
      "label": "example self-hosted: stop",
      "type": "shell",
      "command": "npm run lss:stop",
      "options": { "cwd": "${workspaceFolder}/examples/self-hosted" },
      "icon": { "id": "debug-stop", "color": "terminal.ansiRed" },
      "problemMatcher": []
    },
    {
      "label": "example self-hosted: restart (rebuild local)",
      "detail": "build: all > stop > start — the CLI runs the compiled dist/, so this is the way to see local changes in the example",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build: all",
        "example self-hosted: stop",
        "example self-hosted: start (no Docker)"
      ],
      "icon": { "id": "refresh", "color": "terminal.ansiYellow" },
      "problemMatcher": []
    },
    {
      "label": "example self-hosted: full demo",
      "detail": "start > register > pipeline > catalog — what sets LSS apart, in one task",
      "dependsOrder": "sequence",
      "dependsOn": [
        "example self-hosted: start (no Docker)",
        "example self-hosted: register services",
        "example self-hosted: drive pipeline",
        "example self-hosted: drive catalog (OpenSearch)"
      ],
      "icon": { "id": "rocket", "color": "terminal.ansiYellow" },
      "problemMatcher": []
    }
  ]
}
