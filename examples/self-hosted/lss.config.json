{
  "region": "us-west-2",
  "persistence": true,
  "debug": false,
  "stateDir": ".lss",
  "seedsDir": "./seeds",
  "autoPackage": true,
  "lambdaRuntime": {
    "enabled": true,
    "execution": "source",
    "watch": true
  },
  "branding": {
    "title": "Self-Hosted Services",
    "subtitle": "Every AWS service emulated in-process by LSS — no Docker, no tokens",
    "logo": "./assets/logo.svg",
    "favicon": "./assets/logo.svg",
    "defaultTheme": "dark",
    "colors": {
      "brand-primary": "#0d9488"
    },
    "themeColors": {
      "dark": {
        "brand-primary": "#2dd4bf",
        "brand-hover": "#5eead4",
        "brand-soft": "#134e4a",
        "brand-contrast": "#042f2e"
      }
    }
  },
  "serviceRuntime": {}
}
