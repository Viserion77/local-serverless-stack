{
  "serverPort": 3150,
  "engine": "self",
  "selfEngine": {
    "port": 14566
  },
  "region": "us-east-1",
  "persistence": true,
  "debug": false,
  "stateDir": ".lss",
  "autoPackage": true,
  "lambdaRuntime": {
    "enabled": true,
    "execution": "source",
    "watch": true
  },
  "branding": {
    "themeColors": {
      "light": {
        "brand-primary": "#15803d",
        "brand-hover": "#166534",
        "brand-soft": "#dcfce7"
      },
      "dark": {
        "brand-primary": "#4ade80",
        "brand-hover": "#86efac",
        "brand-soft": "#14532d",
        "brand-contrast": "#052e16"
      }
    }
  }
}
