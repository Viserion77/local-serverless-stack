# Example serverless.yml with LSS (Local Serverless Stack) configuration

service: example-service

frameworkVersion: '3'

provider:
  name: aws
  runtime: nodejs18.x
  region: us-east-1

functions:
  hello:
    handler: src/handlers/hello.handler
    events:
      - http:
          path: hello
          method: get

plugins:
  - lss-serverless-plugin
  - serverless-offline

custom:
  # LSS Plugin Configuration
  # Points to the LSS Orchestrator server
  orchestrator:
    # Enable/disable the plugin
    enabled: true
    # URL where the LSS Orchestrator is running
    # Make sure this matches the serverPort in lss.config.json
    # Default: http://localhost:3100
    orchestratorUrl: http://localhost:3100
  
  # Serverless Offline Configuration
  serverless-offline:
    # Port where Lambda functions will be invoked
    lambdaPort: 3001
    # HTTP server port
    httpPort: 3000

package:
  individually: false
