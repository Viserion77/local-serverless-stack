{
  "serverPort": 3100,
  "selfEngine": {
    "port": 14566,
    "account": "000000000000",
    "idleUnloadMs": 300000,
    "memoryBudgetMb": 128,
    "fsync": false,
    "fallbackEndpoint": null
  },
  "enableDynamoProxy": false,
  "dynamoProxyPort": 8000,
  "region": "us-east-1",
  "persistence": true,
  "debug": false,
  "seedsDir": "./seeds",
  "stateDir": ".lss",
  "autoPackage": false,
  "packageCommand": "npx serverless package",
  "packageTimeoutMs": 300000,
  "packageArgs": [],
  "packageEnv": {},
  "servicePackaging": {
    "users-service": { "packageArgs": ["--param=custom-stage=offline"] }
  },
  "lambdaRuntime": {
    "enabled": true,
    "execution": "auto",
    "invokePortOffset": 10000,
    "lazy": true,
    "idleTimeoutMs": 60000,
    "maxWarmWorkers": 8
  },
  "serviceRuntime": {
    "users-service": { "apiPort": 3010, "invokePort": 13010 }
  },
  "branding": {
    "title": "Local Serverless Stack",
    "subtitle": "Local development control plane",
    "logo": "./assets/logo.svg",
    "favicon": "./assets/favicon.ico",
    "defaultTheme": "dark",
    "colors": {
      "brand-primary": "#0d9488",
      "brand-hover": "#0f766e"
    },
    "themeColors": {
      "dark": { "brand-primary": "#2dd4bf" },
      "light": { "brand-primary": "#0d9488" }
    }
  }
}
