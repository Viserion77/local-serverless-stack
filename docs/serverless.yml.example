# Minimal serverless.yml template for a service running under LSS.
# Complete, runnable versions live under examples/self-hosted/*-service/.
#
# No plugin needed: register the service with `npx lss register <path>`, the
# dashboard onboarding, or POST /api/services/register — the orchestrator
# packages it when needed (autoPackage) and reads everything else from the
# packaged .serverless/serverless-state.json.

service: example-service

frameworkVersion: '3'

provider:
  name: aws
  runtime: nodejs20.x
  region: us-east-1

functions:
  hello:
    handler: src/handlers/hello.handler
    events:
      - http:
          path: hello
          method: get

custom:
  # Ports LSS binds for this service. Optional: without them the service gets
  # no HTTP listener but stays invocable via POST /api/lambdas/:name/invoke.
  # invokePort defaults to apiPort + lambdaRuntime.invokePortOffset (10000).
  lss:
    apiPort: 3000     # HTTP API (API Gateway emulation)
    invokePort: 3001  # direct Lambda invocations

# Infrastructure resources are provisioned on registration. Supported types:
# DynamoDB tables, SQS queues, SNS topics, S3 buckets (incl. notifications),
# EventBridge buses/rules, Lambda event source mappings and OpenSearch
# Serverless collections. Example:
#
# resources:
#   Resources:
#     SearchCollection:
#       Type: AWS::OpenSearchServerless::Collection
#       Properties:
#         Name: example-search        # served at <engine>/_aoss/example-search
#         Type: SEARCH

package:
  individually: false
